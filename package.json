{
    "name": "jinja-py",
    "displayName": "Jinja Py",
    "description": "Jinja2 syntax highlighting, formatting, folding, autocomplete and breakpoint support for HTML templates",
    "version": "1.3.2",
    "publisher": "BachiMjavanadze",
    "author": "Bachi Mjavanadze",
    "engines": {
        "vscode": "^1.109.0"
    },
    "activationEvents": [
        "onLanguage:html",
        "onLanguage:jinja-html",
        "onLanguage:jinja"
    ],
    "license": "MIT",
    "icon": "icon.webp",
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "keywords": [
        "jinja",
        "jinja2",
        "flask",
        "fastapi",
        "html"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/BachiMjavanadze/jinja-py.git"
    },
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "build": "esbuild ./src/extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
        "watch": "npm run build -- --watch",
        "package": "esbuild ./src/extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify"
    },
    "contributes": {
        "configuration": {
            "title": "Jinja Py",
            "properties": {
                "jinjaPy": {
                    "type": "object",
                    "additionalProperties": false,
                    "default": {
                        "framework": "flask",
                        "jinjaSnippets": true
                    },
                    "description": "Jinja Py settings.",
                    "properties": {
                        "framework": {
                            "type": "string",
                            "enum": [
                                "flask",
                                "django",
                                "fastapi",
                                "none"
                            ],
                            "enumDescriptions": [
                                "Flask + Flask-Login + Flask-WTF + Flask-Babel globals, objects, and filters",
                                "Django (Jinja2 backend) globals, request attributes, and default context processors",
                                "FastAPI / Starlette globals and request attributes",
                                "Pure Jinja built-ins only; no framework-specific completions"
                            ],
                            "default": "flask",
                            "description": "Which web framework's built-in template names to autocomplete inside Jinja delimiters."
                        },
                        "jinjaSnippets": {
                            "type": "boolean",
                            "default": true,
                            "description": "Offer the built-in 'j.' snippets. Disable to use your own snippets instead."
                        }
                    }
                }
            }
        },
        "languages": [
            {
                "id": "jinja-html",
                "aliases": [
                    "Jinja HTML",
                    "jinja-html"
                ],
                "extensions": [
                    ".jinja",
                    ".jinja2",
                    ".j2",
                    ".html.j2"
                ],
                "configuration": "./src/syntaxes/language-configuration.json"
            },
            {
                "id": "jinja",
                "aliases": [
                    "Jinja Raw",
                    "jinja-raw"
                ],
                "extensions": [],
                "configuration": "./src/syntaxes/language-configuration.json"
            }
        ],
        "htmlLanguageParticipants": [
            {
                "languageId": "jinja-html",
                "autoInsert": true
            }
        ],
        "grammars": [
            {
                "language": "jinja-html",
                "scopeName": "text.html.jinja",
                "path": "./src/syntaxes/jinja-html.tmLanguage.json"
            },
            {
                "language": "jinja",
                "scopeName": "source.jinja",
                "path": "./src/syntaxes/jinja.tmLanguage.json"
            },
            {
                "scopeName": "jinja-html-injection",
                "path": "./src/syntaxes/jinja-html-injection.tmLanguage.json",
                "injectTo": [
                    "text.html.basic",
                    "text.html.derivative"
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "jinja-html"
            }
        ]
    },
    "devDependencies": {
        "esbuild": "^0.28.0",
        "js-beautify": "^1.15.4"
    }
}
